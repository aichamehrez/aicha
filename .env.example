# ==============================================================================
#  OpenClaw + Ollama Deployment Stack — Environment Configuration (EXAMPLE)
# ==============================================================================

# Admin password for the OpenClaw web UI
OPENCLAW_ADMIN_PASSWORD=CHANGEME_YOUR_PASSWORD

# Shared secret used for internal API signing
OPENCLAW_SECRET_KEY=CHANGEME_YOUR_SECRET_KEY

# Google Gemini API key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Ollama service URL
OLLAMA_BASE_URL=http://ollama:11434

# Default model
OLLAMA_MODEL_NAME=qwen2.5:7b-instruct-q4_K_M

# Extra models
OLLAMA_EXTRA_MODELS=phi4-mini:latest,dolphin-phi,llava:7b-v1.6-mistral-q6_K,hermes3:8b,llama3.2:3b,qwen3:4b
# Target VM SSH Agent Credentials
TARGET_VM_IP=192.168.X.X
TARGET_VM_PORT=22
TARGET_VM_USER=target_user
TARGET_VM_PASSWORD=your_password_here

OPENCLAW_AGENT_CONCURRENCY=4
OPENCLAW_TOOL_TIMEOUT=120
OPENCLAW_LOG_LEVEL=info
OPENCLAW_DATA_DIR=/home/node/.openclaw
NVIDIA_VISIBLE_DEVICES=all
TOOLS_ALLOW="[\"*\"]"
OLLAMA_MODEL_TOOL_SUPPORT=true
OPENCLAW_DISABLE_META_AGENT=true
OPENCLAW_FORCE_TOOL_INJECTION=true
TARGET_VM_KEY_PATH=
OPENAI_BASE_URL=